# ============================================================
# RentFlow — Environment Template
# ============================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ============================================================

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=changeme

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_64_char_hex
JWT_EXPIRATION=86400000

# Safaricom Daraja — https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_SHORTCODE=174379
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/payments/callback

# Email — Gmail App Password from https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth-service:8080
LEASE_SERVICE_URL=http://lease-service:8081
PROPERTY_SERVICE_URL=http://property-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8086
MPESA_SERVICE_URL=http://mpesa-service:8088
NOTIFICATION_SERVICE_URL=http://notification-engine:8080
TICKET_SERVICE_URL=http://maintenance-service:8084

# Gateway
GATEWAY_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL_GATEWAY=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_COM_APEX_AUTH=DEBUG
LOG_LEVEL_COM_APEX_MPESA=DEBUG
LOG_LEVEL_COM_APEX_PAYMENT=DEBUG
LOG_LEVEL_KAFKA=INFO