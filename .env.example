
# ============================================================================

# RentFlow — Environment Variables Reference

# ============================================================================

# Copy to `.env` and fill in real values for local dev:

#     cp .env.example .env

#

# Production: set these in your deployment platform (AWS Secrets Manager,

# Kubernetes Secrets, Docker Swarm Secrets, or the CI/CD pipeline). Never

# commit a filled `.env` file.

#

# Generate strong values with:

#     ./scripts/generate-secrets.sh

# ============================================================================



# ---------- Databases ----------



# PostgreSQL

POSTGRES_DB=rentflow

POSTGRES_USER=rentflow

POSTGRES_PASSWORD=CHANGE_ME



# MongoDB

MONGO_USER=rentflow

MONGO_PASSWORD=CHANGE_ME



# Redis (used by gateway rate limiter + admin cache)

REDIS_PASSWORD=CHANGE_ME



# ---------- JWT (64 hex chars each — DO NOT reuse) ----------



# Access token signing key. Compromise = anyone can impersonate any user.

JWT_ACCESS_SECRET=



# Refresh token signing key. Different from access.

JWT_REFRESH_SECRET=



# ---------- CORS ----------



# Comma-separated origins. Local dev: http://localhost:5173

# Production: https://app.yourdomain.com,https://yourdomain.com

CORS_ALLOWED_ORIGINS=http://localhost:5173



# ---------- Email (SMTP) ----------



SPRING_MAIL_HOST=smtp.gmail.com

SPRING_MAIL_PORT=587

SPRING_MAIL_USERNAME=

SPRING_MAIL_PASSWORD=



# ---------- M-Pesa Daraja ----------



DARAJA_CONSUMER_KEY=

DARAJA_CONSUMER_SECRET=

DARAJA_PASSKEY=

DARAJA_SHORTCODE=174379

DARAJA_CALLBACK_URL=http://localhost:8089/api/v1/mpesa/callback



# ---------- SMS / WhatsApp ----------



# Leave blank in local dev — the channels log a MOCK message

SMS_GATEWAY_URL=

WHATSAPP_GATEWAY_URL=

WHATSAPP_FROM=



# ---------- Observability ----------



GRAFANA_ADMIN_USER=admin

GRAFANA_ADMIN_PASSWORD=CHANGE_ME



# 0.0 – 1.0 sampling rate for distributed tracing

# Local: 1.0 (sample everything). Production: 0.1 (sample 10%)

TRACING_SAMPLE_RATE=1.0



# ---------- Runtime ----------



SPRING_PROFILES_ACTIVE=docker

LOG_LEVEL_NOTIFICATION=DEBUG




# Optional — token lifetimes (milliseconds)

# Defaults: access=900000 (15 min), refresh=604800000 (7 days)

# JWT_ACCESS_EXPIRATION=900000

# JWT_REFRESH_EXPIRATION=604800000

