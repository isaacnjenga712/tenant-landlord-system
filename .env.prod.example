
# ============================================================================

# Production environment variables.

#

# Copy to .env.prod and fill in real values:

#   cp .env.prod.example .env.prod

#

# Never commit .env.prod. Store secrets in your platform's secret manager.

# ============================================================================



# ---------- Database ----------

POSTGRES_DB=rentflow

POSTGRES_USER=rentflow

POSTGRES_PASSWORD=CHANGE_ME_STRONG



MONGO_USER=rentflow

MONGO_PASSWORD=CHANGE_ME_STRONG



REDIS_PASSWORD=CHANGE_ME_STRONG



# ---------- JWT (generate with: openssl rand -hex 64) ----------

JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRATION=900000

JWT_REFRESH_EXPIRATION=604800000



# ---------- CORS ----------

CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com



# ---------- Email ----------

SPRING_MAIL_HOST=smtp.sendgrid.net

SPRING_MAIL_PORT=587

SPRING_MAIL_USERNAME=apikey

SPRING_MAIL_PASSWORD=CHANGE_ME



# ---------- M-Pesa Daraja ----------

DARAJA_CONSUMER_KEY=CHANGE_ME

DARAJA_CONSUMER_SECRET=CHANGE_ME

DARAJA_PASSKEY=CHANGE_ME

DARAJA_SHORTCODE=CHANGE_ME

DARAJA_CALLBACK_URL=https://api.yourdomain.com/api/v1/mpesa/callback



# ---------- SMS / WhatsApp ----------

SMS_GATEWAY_URL=

WHATSAPP_GATEWAY_URL=

WHATSAPP_FROM=



# ---------- Observability ----------

GRAFANA_ADMIN_USER=admin

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG

TRACING_SAMPLE_RATE=0.1



# ---------- Runtime ----------

SPRING_PROFILES_ACTIVE=prod

LOG_LEVEL_NOTIFICATION=INFO

LOG_LEVEL_ADMIN=INFO

