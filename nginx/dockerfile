FROM nginx:1.27-alpine

LABEL maintainer="landlord-system" \
      description="NGINX reverse proxy for landlord-system microservices"

RUN apk add --no-cache curl

RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/    /etc/nginx/conf.d/

# NOTE: `nginx -t` cannot run here — at build time there is no Docker
# network, so the resolver and upstream hostnames are unreachable.
# NGINX validates the config at container start instead.

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]