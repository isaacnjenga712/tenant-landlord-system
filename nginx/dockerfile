FROM nginx:1.27-alpine/nRUN apk add --no-cache wget/nRUN rm -f /etc/nginx/conf.d/default.conf/nCOPY nginx.conf /etc/nginx/nginx.conf/nCOPY conf.d/ /etc/nginx/conf.d//nEXPOSE 80/nHEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget --no-verbose --tries=1 --spider http://localhost/healthz || exit 1/nCMD ["nginx", "-g", "daemon off;"]/n