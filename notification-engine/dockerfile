# Use Alpine-based JRE (small image)
FROM eclipse-temurin:17-jre-alpine

# Metadata
LABEL maintainer="isaackaruku029@gmail.com"
LABEL description="Tenant-Landlord Notification Engine"

# Create working directory
WORKDIR /app

# Copy the built JAR (must exist before building)
COPY target/notification-engine-*.jar app.jar

# Expose application port
EXPOSE 8080

# Install wget for healthcheck (Alpine uses apk)
RUN apk add --no-cache wget

# Health check (requires Spring Boot Actuator)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# Run the application
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]